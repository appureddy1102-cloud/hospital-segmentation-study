# ---------------------------------------------------------------------------
# Large regenerable data
# ---------------------------------------------------------------------------
# The raw and processed extracts are fully reproducible from
#     python src/generate_synthetic_data.py
# and total ~77 MB, which is beyond a comfortable clone size for a code
# review. They are therefore excluded. A 500-row sample of each table is
# committed under data/sample/ so a reviewer can inspect the schema without
# running the pipeline.
data/raw/*
!data/sample/
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Dashboard extract (23 MB Fact_Billing is regenerated by
# src/build_dashboard_doc.py)
dashboards/power_bi/data/*.csv

